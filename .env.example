# Exactly the address people and projects use to open Bastion.
# It becomes the OIDC issuer, so changing it later breaks connected projects.
BASTION_PUBLIC_URL=http://192.168.31.93:8800

# Where to publish the port on the host (IP and port).
BASTION_BIND=192.168.31.93
BASTION_PORT=8800

# Host directory for the database and keys. Back it up.
BASTION_DATA=/srv/bastion-auth/data

# Host user that owns BASTION_DATA.
BASTION_UID=1000
BASTION_GID=1000

# true once Bastion sits behind HTTPS (Caddy, Traefik...).
BASTION_COOKIE_SECURE=false
# true only behind a reverse proxy that sets X-Forwarded-For.
BASTION_TRUST_FORWARDED=false
